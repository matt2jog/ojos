# local starts a loopback Python assistant. dev and prod use their Cloud Run service.
OJOS_DEPLOY_SCOPE=local
GEMINI_API_KEY=
# Use a Cloud Run access token for dev or prod. Leave this empty in local scope.
OJOS_CLOUD_TOKEN=
# Optional HTTPS endpoint override. Set a loopback override with OJOS_DEPLOY_SCOPE=remote.
OJOS_ASSISTANT_URL=
OJOS_LOCAL_TOKEN=
# Desktop vision debugging is enabled by a development build, independently of routing.
